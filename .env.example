# Server (unauthenticated; bind local development services to loopback)
MODELPILOT_CORS_ORIGINS=http://localhost:3000
MODELPILOT_REQUEST_LOG_LIMIT=500
MODELPILOT_METRICS_DB=./data/modelpilot.db
# Optional explicit benchmark suite; blank keeps static quality. No default smoke suite.
# Loaded once at API startup; restart after definition changes. Invalid paths/suites fail startup.
# Relative paths resolve from the backend working directory. This never runs a benchmark.
MODELPILOT_QUALITY_SUITE_PATH=
MODELPILOT_CIRCUIT_FAILURE_THRESHOLD=3
MODELPILOT_CIRCUIT_COOLDOWN_SECONDS=60

# Providers (leave unset to disable a provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Dashboard: export this public URL or put it in frontend/.env.local.
# Next.js does not load this repository-root file. Never include credentials in the URL.
NEXT_PUBLIC_MODELPILOT_API_URL=http://localhost:8000
